<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/bwBackground" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView style="@style/CardTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/favorites_title"
            android:textColor="?attr/bwAccent" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/favorites_hint" android:textColor="?attr/bwTextSecondary"
            android:textSize="13sp" android:layout_marginBottom="12dp" />

        <TextView android:id="@+id/favorites_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/favorites_empty"
            android:textColor="?attr/bwTextSecondary" android:textSize="14sp"
            android:padding="16dp" android:visibility="gone" />

        <LinearLayout android:id="@+id/favorites_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />

        <Button android:id="@+id/favorite_add_search" android:layout_width="match_parent"
            android:layout_height="44dp" android:text="@string/favorite_add_search"
            android:textColor="?attr/bwAccent" android:background="@drawable/bg_chip"
            android:layout_marginTop="12dp" />

        <Button android:id="@+id/favorite_add_current" android:layout_width="match_parent"
            android:layout_height="44dp" android:text="@string/favorite_add_current"
            android:textColor="?attr/bwAccent" android:background="@drawable/bg_chip"
            android:layout_marginTop="6dp" />

        <Button android:id="@+id/favorite_done" android:layout_width="match_parent"
            android:layout_height="44dp" android:text="@string/done"
            android:textColor="?attr/bwTextPrimary" android:background="@drawable/bg_chip"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
