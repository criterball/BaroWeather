<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/bwBackground" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText android:id="@+id/search_input" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:hint="@string/search_hint" android:inputType="text"
            android:textColor="?attr/bwTextPrimary" android:textColorHint="?attr/bwTextSecondary"
            android:background="@drawable/bg_chip" android:paddingLeft="12dp" />
        <Button android:id="@+id/search_go" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="@string/search_button"
            android:textColor="?attr/bwTextPrimary" android:background="@drawable/bg_chip"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <TextView android:id="@+id/search_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/loading"
        android:textColor="?attr/bwTextSecondary" android:textSize="13sp"
        android:layout_marginTop="10dp" />

    <ListView android:id="@+id/results" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:divider="?attr/bwDivider" android:dividerHeight="1dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
