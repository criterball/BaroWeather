<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/bwBackground" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView style="@style/CardTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/symptom_title"
            android:textColor="?attr/bwAccent" />

        <TextView android:id="@+id/symptom_context" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entries stay on this device and appear as dots on pressure history."
            android:textSize="13sp" android:textColor="?attr/bwTextSecondary"
            android:layout_marginTop="4dp" />

        <CheckBox android:id="@+id/check_headache" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Headache"
            android:textColor="?attr/bwTextPrimary" android:textSize="16sp" />
        <CheckBox android:id="@+id/check_dizziness" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Dizziness"
            android:textColor="?attr/bwTextPrimary" android:textSize="16sp" />
        <CheckBox android:id="@+id/check_fatigue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Fatigue"
            android:textColor="?attr/bwTextPrimary" android:textSize="16sp" />
        <CheckBox android:id="@+id/check_joint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Joint pain"
            android:textColor="?attr/bwTextPrimary" android:textSize="16sp" />
        <CheckBox android:id="@+id/check_nausea" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Nausea"
            android:textColor="?attr/bwTextPrimary" android:textSize="16sp" />

        <EditText android:id="@+id/edit_symptom_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/symptom_note_hint"
            android:textColor="?attr/bwTextPrimary" android:textColorHint="?attr/bwTextSecondary"
            android:inputType="textMultiLine" android:minLines="2" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/button_symptom_save" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="@string/save" android:textColor="?attr/bwTextPrimary"
                android:background="@drawable/bg_chip" />
            <Button android:id="@+id/button_symptom_cancel" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="@string/cancel" android:textColor="?attr/bwTextPrimary"
                android:background="@drawable/bg_chip" android:layout_marginLeft="8dp" />
        </LinearLayout>

        <TextView style="@style/CardTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/symptom_recent"
            android:textColor="?attr/bwAccent" android:layout_marginTop="18dp" />

        <LinearLayout android:id="@+id/symptom_recent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
