<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:layout_marginBottom="6dp" android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/day_name" android:layout_width="52dp"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="?attr/bwTextPrimary" />

        <com.baroweather.app.ConditionIconView
            android:id="@+id/day_icon" android:layout_width="36dp" android:layout_height="36dp" />

        <TextView android:id="@+id/day_condition" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textColor="?attr/bwTextSecondary"
            android:maxLines="1" android:ellipsize="end" />

        <TextView android:id="@+id/day_rain" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="?attr/bwAccent" android:layout_marginRight="10dp" />

        <TextView android:id="@+id/day_high" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textStyle="bold" android:textColor="?attr/bwTextPrimary" />

        <TextView android:id="@+id/day_low" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="?attr/bwTextSecondary" android:layout_marginLeft="6dp" />
    </LinearLayout>

    <com.baroweather.app.RangeBarView
        android:id="@+id/day_range" android:layout_width="match_parent"
        android:layout_height="10dp" android:layout_marginTop="4dp" />

    <TextView android:id="@+id/day_detail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="?attr/bwTextSecondary" android:visibility="gone"
        android:layout_marginTop="4dp" />
</LinearLayout>
