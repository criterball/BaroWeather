<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="?attr/bwSurface" android:padding="12dp"
    android:layout_marginBottom="6dp">

    <ImageView android:layout_width="24dp" android:layout_height="24dp"
        android:src="@drawable/ic_star" android:contentDescription="@string/favorite_starred" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginLeft="8dp" android:layout_marginStart="8dp">
        <TextView android:id="@+id/favorite_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/bwTextPrimary" android:textSize="16sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/favorite_coords"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/bwTextSecondary" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <ImageButton android:id="@+id/favorite_open"
        android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_location" android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/open_favorite" />

    <ImageButton android:id="@+id/favorite_remove"
        android:layout_width="40dp" android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/remove_favorite" />
</LinearLayout>
