<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginBottom="10dp">

    <Button
        android:id="@+id/place_button"
        android:layout_width="0dp" android:layout_height="44dp"
        android:layout_weight="1" android:text="@string/default_place"
        android:textSize="14sp" android:ellipsize="end" android:maxLines="1"
        android:background="@drawable/bg_chip" android:textColor="?attr/bwTextPrimary"
        android:paddingLeft="12dp" android:paddingRight="12dp" />

    <ImageButton android:id="@+id/location_button" android:layout_width="44dp"
        android:layout_height="44dp" android:src="@drawable/ic_location"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/use_my_location" />

    <ImageButton android:id="@+id/search_button" android:layout_width="44dp"
        android:layout_height="44dp" android:src="@drawable/ic_search"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/search" />

    <ImageButton android:id="@+id/favorites_button" android:layout_width="44dp"
        android:layout_height="44dp" android:src="@drawable/ic_star"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/favorites" />

    <ImageButton android:id="@+id/refresh_button" android:layout_width="44dp"
        android:layout_height="44dp" android:src="@drawable/ic_refresh"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/refresh" />

    <ImageButton android:id="@+id/settings_button" android:layout_width="44dp"
        android:layout_height="44dp" android:src="@drawable/ic_settings"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/settings" />
</LinearLayout>
